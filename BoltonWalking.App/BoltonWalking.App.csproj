<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>BoltonWalking.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Bolton Walking and Outdoors Appreciation Society</ApplicationTitle>
    <!-- Placeholder - replace with your real registered package/bundle id before publishing -->
    <ApplicationId>com.boltonwalking.app</ApplicationId>

    <!-- Bump this by hand for each real feature release (1.2 -> 1.3 etc). The
         build/revision portion below is computed automatically from the
         current date/time every build - never edit it or ApplicationVersion
         directly. -->
    <MarketingVersion>1.3</MarketingVersion>

    <!-- OLE Automation date: whole part = days since 30 Dec 1899, fractional
         part = time of day (e.g. 46237.47 = 03 Aug 2026, ~11:23). Splitting
         it gives a build id that's always unique and always increasing.
         ApplicationVersion (Android versionCode / iOS CFBundleVersion) must
         be a single plain integer, so it drops the dot: same digits, no ".". -->
    <BuildOADate>$([System.DateTime]::Now.ToOADate().ToString('F2'))</BuildOADate>
    <BuildOADateInt>$(BuildOADate.Split('.')[0])</BuildOADateInt>
    <BuildOADateFrac>$(BuildOADate.Split('.')[1])</BuildOADateFrac>
    <ApplicationDisplayVersion>$(MarketingVersion).$(BuildOADateInt).$(BuildOADateFrac)</ApplicationDisplayVersion>
    <ApplicationVersion>$(BuildOADateInt)$(BuildOADateFrac)</ApplicationVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
    <TargetSdkVersion>36</TargetSdkVersion>
  </PropertyGroup>

  <!-- Release-signing for Play Store uploads. Keystore path/passwords come from
       environment variables (BWOAS_KEYSTORE_PATH, BWOAS_KEYSTORE_PASSWORD,
       BWOAS_KEY_ALIAS, BWOAS_KEY_PASSWORD) rather than being committed here -
       set them before running a Release publish. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release' AND $(TargetFramework.Contains('-android'))">
    <!-- Play Store requires an .aab bundle, not a raw .apk -->
    <AndroidPackageFormat>aab</AndroidPackageFormat>
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(BWOAS_KEYSTORE_PATH)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(BWOAS_KEY_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(BWOAS_KEY_PASSWORD)</AndroidSigningKeyPass>
    <AndroidSigningStorePass>$(BWOAS_KEYSTORE_PASSWORD)</AndroidSigningStorePass>
  </PropertyGroup>

  <ItemGroup>
    <!-- Real club crest (pulled from boltonwalking.co.uk), layered over a solid black background -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\bwoas_crest.png" Color="#000000" />
    <MauiSplashScreen Include="Resources\AppIcon\bwoas_crest.png" Color="#000000" BaseSize="220,220" />
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="Views\**\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Resources\Styles\**\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

  <ItemGroup>
    <!-- Explicit reference needed: CommunityToolkit.Maui 15 requires Maui.Controls newer than the bundled Maui.Sdk 10.0.20 default -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
    <!-- MVVM source generators (INotifyPropertyChanged, [ObservableProperty], [RelayCommand]) -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Map control (Pin, Map, clustering, custom images) - pinned to match the Microsoft.Maui.Sdk workload version -->
    <PackageReference Include="Microsoft.Maui.Controls.Maps" Version="10.0.90" />
    <!-- File save/share (for GPX route downloads) -->
    <PackageReference Include="CommunityToolkit.Maui" Version="15.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
  </ItemGroup>

</Project>
