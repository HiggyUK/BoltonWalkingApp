<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             xmlns:vm="clr-namespace:BoltonWalking.App.ViewModels"
             xmlns:converters="clr-namespace:BoltonWalking.App.Converters"
             x:DataType="vm:RoutesViewModel"
             x:Class="BoltonWalking.App.Views.RoutesPage"
             Title="Routes">

    <ContentPage.Resources>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />

        <Style x:Key="FilterChipBase" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BackgroundColor" Value="White" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh" Command="{Binding LoadRoutesCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*">

        <SearchBar Grid.Row="0"
                   Placeholder="Search routes by name or venue"
                   Text="{Binding SearchText}"
                   BackgroundColor="White" />

        <!-- Difficulty filter chips - narrows which pins BuildPins() shows. -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" BackgroundColor="White">
            <HorizontalStackLayout Padding="16,10" Spacing="8">
                <Button Text="All" Style="{StaticResource FilterChipBase}"
                        TextColor="{DynamicResource Secondary}" BorderColor="#D8D8D8" BorderWidth="1"
                        Command="{Binding FilterByDifficultyCommand}" CommandParameter="All">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedDifficulty}" Value="All">
                            <Setter Property="BackgroundColor" Value="{DynamicResource Secondary}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="Easy" Style="{StaticResource FilterChipBase}"
                        TextColor="#2E8B3D" BorderColor="#2E8B3D" BorderWidth="1"
                        Command="{Binding FilterByDifficultyCommand}" CommandParameter="Easy">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedDifficulty}" Value="Easy">
                            <Setter Property="BackgroundColor" Value="#2E8B3D" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="Moderate" Style="{StaticResource FilterChipBase}"
                        TextColor="#E8850C" BorderColor="#E8850C" BorderWidth="1"
                        Command="{Binding FilterByDifficultyCommand}" CommandParameter="Moderate">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedDifficulty}" Value="Moderate">
                            <Setter Property="BackgroundColor" Value="#E8850C" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="Hard" Style="{StaticResource FilterChipBase}"
                        TextColor="#D0202B" BorderColor="#D0202B" BorderWidth="1"
                        Command="{Binding FilterByDifficultyCommand}" CommandParameter="Hard">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedDifficulty}" Value="Hard">
                            <Setter Property="BackgroundColor" Value="#D0202B" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2">

            <maps:Map x:Name="RoutesMap"
                      IsShowingUser="True" />

            <ActivityIndicator Grid.Row="0"
                                IsRunning="{Binding IsBusy}"
                                IsVisible="{Binding IsBusy}"
                                VerticalOptions="Start"
                                Margin="0,16"
                                Color="{DynamicResource Primary}" />

            <Label x:Name="NoResultsLabel"
                   IsVisible="False"
                   Text="No routes match your search/filter."
                   HorizontalOptions="Center"
                   VerticalOptions="Start"
                   Margin="0,16"
                   Padding="12,8"
                   BackgroundColor="White"
                   TextColor="{DynamicResource TextMuted}"
                   FontSize="14" />

            <!-- TEMP debug diagnostic, remove once iOS pin colouring is confirmed working -->
            <Label x:Name="DebugLabel"
                   Text=""
                   HorizontalOptions="Fill"
                   VerticalOptions="End"
                   Padding="8"
                   BackgroundColor="Black"
                   TextColor="Lime"
                   FontSize="10" />

            <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                    VerticalOptions="Start"
                    Margin="16"
                    Padding="12"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{DynamicResource Primary}">
                <Label Text="{Binding ErrorMessage}" TextColor="White" FontSize="13" />
            </Border>

            <!--
                Custom brief-info popup, shown over the map when a pin is tapped.
                We deliberately don't use the native pin callout here - it can only
                show plain text (label/address), not a tappable "View details" link.
            -->
            <Border IsVisible="{Binding IsPopupVisible}"
                    VerticalOptions="End"
                    Margin="16"
                    Padding="16"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="White">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.25" Radius="12" Offset="0,4" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding SelectedRoute.Name}"
                           FontAttributes="Bold"
                           FontSize="17" />
                    <Label Text="{Binding SelectedRoute.ShortDescription}"
                           FontSize="14" />

                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <Button Grid.Column="0"
                                Text="View details"
                                HorizontalOptions="Start"
                                Padding="12,8"
                                Clicked="OnViewDetailsClicked" />
                        <Button Grid.Column="1"
                                Text="Close"
                                BackgroundColor="Transparent"
                                TextColor="Gray"
                                Command="{Binding DismissPopupCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </Grid>

    </Grid>

</ContentPage>
