<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             xmlns:vm="clr-namespace:BoltonWalking.App.ViewModels"
             xmlns:converters="clr-namespace:BoltonWalking.App.Converters"
             x:DataType="vm:RoutesViewModel"
             x:Class="BoltonWalking.App.Views.RoutesPage"
             Title="Routes">

    <ContentPage.Resources>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh" Command="{Binding LoadRoutesCommand}" />
    </ContentPage.ToolbarItems>

    <Grid>

        <maps:Map x:Name="RoutesMap"
                  IsShowingUser="True" />

        <ActivityIndicator Grid.Row="0"
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            VerticalOptions="Start"
                            Margin="0,16"
                            Color="{DynamicResource Primary}" />

        <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                VerticalOptions="Start"
                Margin="16"
                Padding="12"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="{DynamicResource Primary}">
            <Label Text="{Binding ErrorMessage}" TextColor="White" FontSize="13" />
        </Border>

        <!--
            Custom brief-info popup, shown over the map when a pin is tapped.
            We deliberately don't use the native pin callout here - it can only
            show plain text (label/address), not a tappable "View details" link.
        -->
        <Border IsVisible="{Binding IsPopupVisible}"
                VerticalOptions="End"
                Margin="16"
                Padding="16"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.25" Radius="12" Offset="0,4" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding SelectedRoute.Name}"
                       FontAttributes="Bold"
                       FontSize="17" />
                <Label Text="{Binding SelectedRoute.ShortDescription}"
                       FontSize="14" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Button Grid.Column="0"
                            Text="View details"
                            HorizontalOptions="Start"
                            Padding="12,8"
                            Clicked="OnViewDetailsClicked" />
                    <Button Grid.Column="1"
                            Text="Close"
                            BackgroundColor="Transparent"
                            TextColor="Gray"
                            Command="{Binding DismissPopupCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
