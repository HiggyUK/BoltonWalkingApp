<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BoltonWalking.App.Views.AboutPage"
             Title="About">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Full-bleed hero photo from a real club walk -->
            <Image Source="hero_about.jpg"
                   Aspect="AspectFill"
                   HeightRequest="220" />

            <VerticalStackLayout Padding="24" Spacing="14">

                <Image Source="bwoas_crest.png"
                       HeightRequest="110"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       Margin="0,-70,0,0" />

                <Label Text="Bolton Walking and Outdoors Appreciation Society"
                       FontSize="23"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="{DynamicResource Secondary}" />

                <Border BackgroundColor="{DynamicResource Primary}"
                        StrokeShape="RoundRectangle 20"
                        Stroke="Transparent"
                        Padding="14,6"
                        HorizontalOptions="Center">
                    <Label Text="Est. 2011 &#8226; Celebrating 15 years"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="White" />
                </Border>

                <Label Text="A friendly walking and outdoors group based in Bolton, organising regular walks across the West Pennine Moors and beyond. All abilities welcome - come and join us!"
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       Margin="0,6,0,0" />

                <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,10" />

                <Label Text="GET IN TOUCH"
                       FontSize="13"
                       FontAttributes="Bold"
                       CharacterSpacing="1"
                       TextColor="{DynamicResource TextMuted}"
                       HorizontalOptions="Center" />

                <Button Text="Email us"
                        BackgroundColor="{DynamicResource Primary}"
                        TextColor="White"
                        Clicked="OnEmailClicked" />

                <Button Text="Visit our website"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Primary}"
                        BorderColor="{DynamicResource Primary}"
                        BorderWidth="1"
                        Clicked="OnWebsiteClicked" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
