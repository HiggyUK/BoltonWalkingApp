<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BoltonWalking.App.ViewModels"
             xmlns:models="clr-namespace:BoltonWalking.App.Models"
             xmlns:converters="clr-namespace:BoltonWalking.App.Converters"
             x:DataType="vm:RouteDetailsViewModel"
             x:Class="BoltonWalking.App.Views.RouteDetailsPage"
             x:Name="PageRoot"
             Title="{Binding Route.Name}">

    <ContentPage.Resources>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
        <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
        <converters:DifficultyToColorConverter x:Key="DifficultyToColorConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                                IsVisible="{Binding IsBusy}"
                                Color="{DynamicResource Primary}"
                                Margin="0,12" />

            <!-- Photo carousel, auto-advances on a timer (see code-behind) -->
            <Grid IsVisible="{Binding Route.PhotoUrls.Count, Converter={StaticResource IntToBoolConverter}}"
                  HeightRequest="220">
                <CarouselView x:Name="PhotoCarousel"
                              ItemsSource="{Binding Route.PhotoUrls}"
                              IndicatorView="PhotoIndicator"
                              Loop="True">
                    <CarouselView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Image Source="{Binding .}" Aspect="AspectFill" />
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>

                <IndicatorView x:Name="PhotoIndicator"
                               IndicatorColor="#88FFFFFF"
                               SelectedIndicatorColor="White"
                               VerticalOptions="End"
                               HorizontalOptions="Center"
                               Margin="0,0,0,10" />
            </Grid>

            <VerticalStackLayout Padding="20" Spacing="16">

                <Label Text="{Binding Route.Name}" FontSize="24" FontAttributes="Bold" TextColor="{DynamicResource Secondary}" />

                <!-- Difficulty + stats -->
                <FlexLayout Wrap="Wrap" AlignItems="Center" JustifyContent="Start">
                    <Border BackgroundColor="{Binding Route.Difficulty, Converter={StaticResource DifficultyToColorConverter}}"
                            StrokeShape="RoundRectangle 14"
                            Stroke="Transparent"
                            Padding="12,5"
                            Margin="0,0,8,8">
                        <Label Text="{Binding Route.DifficultyBadge}" TextColor="White" FontAttributes="Bold" FontSize="13" />
                    </Border>
                    <Label Text="{Binding Route.Stats}" FontSize="14" TextColor="{DynamicResource TextMuted}" VerticalOptions="Center" Margin="0,0,0,8" />
                </FlexLayout>

                <Label Text="{Binding Route.TerrainNotes}" FontSize="15" />

                <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,4" />

                <!-- Starting point -->
                <Label Text="STARTING POINT" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="{DynamicResource TextMuted}" />
                <Label FontSize="15">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Route.Venue}" FontAttributes="Bold" />
                            <Span Text="&#10;" />
                            <Span Text="{Binding Route.Address}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label FontSize="13" TextColor="{DynamicResource TextMuted}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="what3words: " FontAttributes="Bold" />
                            <Span Text="{Binding Route.What3Words}"
                                  TextColor="{DynamicResource Primary}"
                                  TextDecorations="Underline">
                                <Span.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenWhat3WordsCommand}" />
                                </Span.GestureRecognizers>
                            </Span>
                            <Span Text="   grid ref: " FontAttributes="Bold" />
                            <Span Text="{Binding Route.GridReference}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Transport -->
                <Label Text="GETTING THERE" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="{DynamicResource TextMuted}" Margin="0,8,0,0" />
                <Label Text="{Binding Route.TransportNotes}" FontSize="15" />

                <!-- Parking -->
                <Label Text="PARKING" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="{DynamicResource TextMuted}" Margin="0,8,0,0" />
                <Label Text="{Binding Route.ParkingNotes}" FontSize="15" />

                <Label Text="Downloads"
                       FontSize="17"
                       FontAttributes="Bold"
                       Margin="0,12,0,0"
                       IsVisible="{Binding Route.Files.Count, Converter={StaticResource IntToBoolConverter}}" />

                <CollectionView ItemsSource="{Binding Route.Files}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:DownloadableFile">
                            <Border Padding="12" Margin="0,4" Stroke="#E0E0E0" StrokeShape="RoundRectangle 8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding FileName}" FontAttributes="Bold" />
                                        <Label Text="{Binding Description}" FontSize="12" TextColor="{DynamicResource TextMuted}" />
                                    </VerticalStackLayout>
                                    <!-- Bind back to the page's BindingContext (the view model) via
                                         x:Reference, since inside this DataTemplate the implicit
                                         BindingContext is the DownloadableFile, not the view model. -->
                                    <Button Grid.Column="1"
                                            Text="Download"
                                            Padding="10,6"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DownloadFileCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding StatusMessage}"
                       FontSize="13"
                       TextColor="{DynamicResource Primary}"
                       IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
