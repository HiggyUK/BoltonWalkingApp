<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BoltonWalking.App.ViewModels"
             xmlns:models="clr-namespace:BoltonWalking.App.Models"
             xmlns:converters="clr-namespace:BoltonWalking.App.Converters"
             x:DataType="vm:BookViewModel"
             x:Class="BoltonWalking.App.Views.BookPage"
             x:Name="PageRoot"
             Title="Book">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh" Command="{Binding LoadEventsCommand}" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
        <converters:IntToInverseBoolConverter x:Key="IntToInverseBoolConverter" />
        <converters:DifficultyToColorConverter x:Key="DifficultyToColorConverter" />
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Full-bleed hero photo, same treatment as About -->
            <Image Source="hero_book.jpg"
                   Aspect="AspectFill"
                   HeightRequest="180" />

            <VerticalStackLayout Padding="24" Spacing="14">

                <Image Source="bwoas_crest.png"
                       HeightRequest="90"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       Margin="0,-55,0,0" />

                <Label Text="Book a Walk"
                       FontSize="23"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource Secondary}" />

                <Label Text="Check out the available walks below."
                       FontSize="16"
                       HorizontalTextAlignment="Center" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                    IsVisible="{Binding IsBusy}"
                                    Color="{DynamicResource Primary}" />

                <Label Text="{Binding ErrorMessage}"
                       FontSize="14"
                       TextColor="{DynamicResource Primary}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                <Label Text="No upcoming walks right now - check back soon."
                       FontSize="15"
                       TextColor="{DynamicResource TextMuted}"
                       IsVisible="{Binding Events.Count, Converter={StaticResource IntToInverseBoolConverter}}" />

                <CollectionView ItemsSource="{Binding Events}"
                                 IsVisible="{Binding Events.Count, Converter={StaticResource IntToBoolConverter}}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:EventItem">
                            <Border BackgroundColor="{DynamicResource SurfaceMuted}"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <VerticalStackLayout Spacing="6">

                                    <Label FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource Secondary}">
                                        <Label.Text>
                                            <Binding Path="Route.Name" TargetNullValue="Route no longer available" />
                                        </Label.Text>
                                    </Label>

                                    <Label Text="{Binding Route.Venue}" FontSize="13" TextColor="{DynamicResource TextMuted}" />

                                    <FlexLayout Wrap="Wrap" AlignItems="Center" JustifyContent="Start" Margin="0,4,0,0">
                                        <Border BackgroundColor="{Binding Route.Difficulty, Converter={StaticResource DifficultyToColorConverter}}"
                                                StrokeShape="RoundRectangle 14"
                                                Stroke="Transparent"
                                                Padding="12,5"
                                                Margin="0,0,8,0">
                                            <Label Text="{Binding Route.DifficultyBadge}" TextColor="White" FontAttributes="Bold" FontSize="12" />
                                        </Border>
                                        <Label Text="{Binding DisplayDate}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                    </FlexLayout>

                                    <Label Text="{Binding DisplayTime}" FontSize="14" TextColor="{DynamicResource TextMuted}" />

                                    <!-- Bookable: normal red button that opens the ticket link.
                                         Not yet bookable: disabled, shows when it opens instead. -->
                                    <Button Text="Book this walk"
                                            IsVisible="{Binding IsBookable}"
                                            BackgroundColor="{DynamicResource Primary}"
                                            TextColor="White"
                                            Margin="0,8,0,0"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenTicketLinkCommand}"
                                            CommandParameter="{Binding .}" />

                                    <Button Text="{Binding BookingOpensDisplay}"
                                            IsVisible="{Binding IsBookable, Converter={StaticResource InvertedBoolConverter}}"
                                            IsEnabled="False"
                                            BackgroundColor="#D8D8D8"
                                            TextColor="{DynamicResource TextMuted}"
                                            Margin="0,8,0,0" />

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,6" />

                <Button Text="Open full Ticket Tailor calendar"
                        ImageSource="icon_book_white.svg"
                        ContentLayout="Left,10"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Primary}"
                        BorderColor="{DynamicResource Primary}"
                        BorderWidth="1"
                        Command="{Binding OpenBookingPageCommand}" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
