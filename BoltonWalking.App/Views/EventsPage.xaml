<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BoltonWalking.App.ViewModels"
             xmlns:models="clr-namespace:BoltonWalking.App.Models"
             xmlns:converters="clr-namespace:BoltonWalking.App.Converters"
             x:DataType="vm:EventsViewModel"
             x:Class="BoltonWalking.App.Views.EventsPage"
             x:Name="PageRoot"
             Title="Events">

    <ContentPage.Resources>
        <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
        <converters:IntToInverseBoolConverter x:Key="IntToInverseBoolConverter" />
        <converters:DifficultyToColorConverter x:Key="DifficultyToColorConverter" />
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Upcoming Events"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource Secondary}" />

            <Label Text="Scheduled walks open for booking."
                   FontSize="15"
                   TextColor="{DynamicResource TextMuted}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                                IsVisible="{Binding IsBusy}"
                                Color="{DynamicResource Primary}" />

            <Label Text="{Binding ErrorMessage}"
                   FontSize="14"
                   TextColor="{DynamicResource Primary}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Label Text="No upcoming events right now - check back soon."
                   FontSize="15"
                   TextColor="{DynamicResource TextMuted}"
                   IsVisible="{Binding Events.Count, Converter={StaticResource IntToInverseBoolConverter}}" />

            <CollectionView ItemsSource="{Binding Events}"
                             IsVisible="{Binding Events.Count, Converter={StaticResource IntToBoolConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:EventItem">
                        <Border BackgroundColor="{DynamicResource SurfaceMuted}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 12"
                                Padding="16"
                                Margin="0,0,0,12">
                            <VerticalStackLayout Spacing="6">

                                <Label FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource Secondary}">
                                    <Label.Text>
                                        <Binding Path="Route.Name" TargetNullValue="Route no longer available" />
                                    </Label.Text>
                                </Label>

                                <Label Text="{Binding Route.Venue}" FontSize="13" TextColor="{DynamicResource TextMuted}" />

                                <FlexLayout Wrap="Wrap" AlignItems="Center" JustifyContent="Start" Margin="0,4,0,0">
                                    <Border BackgroundColor="{Binding Route.Difficulty, Converter={StaticResource DifficultyToColorConverter}}"
                                            StrokeShape="RoundRectangle 14"
                                            Stroke="Transparent"
                                            Padding="12,5"
                                            Margin="0,0,8,0">
                                        <Label Text="{Binding Route.DifficultyBadge}" TextColor="White" FontAttributes="Bold" FontSize="12" />
                                    </Border>
                                    <Label Text="{Binding DisplayDate}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                </FlexLayout>

                                <Label Text="{Binding DisplayTime}" FontSize="14" TextColor="{DynamicResource TextMuted}" />

                                <Button Text="Book this walk"
                                        BackgroundColor="{DynamicResource Primary}"
                                        TextColor="White"
                                        Margin="0,8,0,0"
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenTicketLinkCommand}"
                                        CommandParameter="{Binding .}" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
