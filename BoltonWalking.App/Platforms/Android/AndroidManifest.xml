    <application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round"
                 android:supportsRtl="true">

        <!--
            Required for the Map control on Android even though MAUI wraps
            Google Maps for you. Get a key from the Google Cloud Console
            (Maps SDK for Android), restricted to this app's package name /
            SHA-1 signing cert.
