<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             xmlns:vm="clr-namespace:Clubs.Shared.ViewModels"
             x:DataType="vm:MapViewModel"
             x:Class="Clubs.Shared.Views.MapPage"
             Title="Map">

    <Grid>

        <maps:Map x:Name="LocationsMap"
                  IsShowingUser="True" />

        <ActivityIndicator Grid.Row="0"
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            VerticalOptions="Start"
                            Margin="0,16"
                            Color="{DynamicResource Primary}" />

        <!--
            Custom brief-info popup, shown over the map when a pin is tapped.
            We deliberately don't use the native pin callout here - it can only
            show plain text (label/address), not a tappable "View details" link.
        -->
        <Border IsVisible="{Binding IsPopupVisible}"
                VerticalOptions="End"
                Margin="16"
                Padding="16"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.25" Radius="12" Offset="0,4" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding SelectedLocation.Name}"
                       FontAttributes="Bold"
                       FontSize="17" />
                <Label Text="{Binding SelectedLocation.ShortDescription}"
                       FontSize="14" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Button Grid.Column="0"
                            Text="View details"
                            HorizontalOptions="Start"
                            Padding="12,8"
                            Clicked="OnViewDetailsClicked" />
                    <Button Grid.Column="1"
                            Text="Close"
                            BackgroundColor="Transparent"
                            TextColor="Gray"
                            Command="{Binding DismissPopupCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
