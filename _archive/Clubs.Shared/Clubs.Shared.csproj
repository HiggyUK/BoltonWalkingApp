<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- This is a MAUI CLASS LIBRARY, not an app - it has no ApplicationId/icon/etc.
         Both ClubA.App and ClubB.App reference it and get all of this for free. -->
    <TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Clubs.Shared</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <MauiXaml Update="Views\**\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Resources\Styles\**\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

  <ItemGroup>
    <!-- MVVM source generators (INotifyPropertyChanged, [ObservableProperty], [RelayCommand]) -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Map control (Pin, Map, clustering, custom images) -->
    <PackageReference Include="Microsoft.Maui.Controls.Maps" Version="9.0.120" />
    <!-- Popups (for the pin's brief-info popup) and file save/share (for GPX downloads) -->
    <PackageReference Include="CommunityToolkit.Maui" Version="9.1.0" />
  </ItemGroup>

</Project>
